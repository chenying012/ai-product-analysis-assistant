# Copy to .env.local. Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional. A vision-capable model on the same endpoint enables product image analysis.
# Visible attributes are added as separate V-numbered evidence, never mixed into page text facts.
# Leave empty to skip image analysis. Example: gpt-4.1-mini, qwen-vl-plus
OPENAI_VISION_MODEL=

# direct: fetch public Amazon HTML; access restrictions may prevent collection.
# firecrawl: use your own Firecrawl account after confirming its cost and terms.
PRODUCT_SOURCE=direct
FIRECRAWL_API_KEY=

# Optional. Amazon hides the price of a listing it cannot ship to the server's region, and that price is
# absent from the HTML, so it cannot be parsed back. Point this at your own HTTPS relay that fetches the
# page from a region Amazon serves; {url} receives the URL-encoded product page.
# Example: https://relay.example.com/fetch?url={url}
PRODUCT_FETCH_ENDPOINT=

# Optional: protect the application before sharing it publicly.
# Leave empty for local development. Set a long random value for public access.
APP_ACCESS_TOKEN=
